# Copy to engine/.env and fill in. Never commit the real .env.

# Claude API key — optional, enables LLM verification queries and the polished report
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional model overrides
# AGENT_MODEL=
# SYNTH_MODEL=
# CHAT_MODEL=

# Semantic Scholar — optional, raises rate limits
S2_API_KEY=your-semantic-scholar-key

# OpenAlex — mailto is free (no signup); API key is optional
OPENALEX_MAILTO=your_email@example.com
OPENALEX_API_KEY=
